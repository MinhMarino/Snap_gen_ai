# Qwen3-TTS 1.7B local (Docker)
#
# Mac M2 / Docker Desktop = CPU only (no CUDA / no MPS inside container).
# Docker Desktop → Settings → Resources → Memory: set >= 12 GB before start.

# demo | api | both
MODE=both

# Models:
#   Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice   (9 speakers + instruct)  ← default
#   Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign   (design voice from text)
#   Qwen/Qwen3-TTS-12Hz-1.7B-Base          (voice clone; Gradio only)
# Lighter fallback if OOM:
#   Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice

DEVICE=cpu
DTYPE=float32

DEMO_PORT=8000
API_PORT=8080

# Set 1 to load model at container start (slower boot, faster first request)
WARMUP=0

# Optional: Hugging Face token
# HF_TOKEN=
